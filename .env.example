# Entorno Django
DEBUG=True
SECRET_KEY=django-insecure-riesgoti-dev-secret-key-change-in-prod-2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# Base de Datos PostgreSQL (Esquema bd.sql — contenedor db o localhost:5432)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=riesgo_ti
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DB_PORT_HOST=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/riesgo_ti

# Consola pgAdmin 4 (http://localhost:5050)
PGADMIN_DEFAULT_EMAIL=admin@riesgoti.com
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5050

# Criptografía AES-256-GCM (32 bytes exactos en Base64)
# Generar: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
RIESGOTI_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Celery & Redis (contenedor redis o localhost:6379)
REDIS_PORT_HOST=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=django-db

# CORS Frontend Vite
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
